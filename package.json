{
  "name": "webhook-crash-lab",
  "version": "0.3.0",
  "description": "Crash-test your Stripe-style webhook handler: replay duplicate, concurrent, out-of-order, unsigned and stale deliveries, then assert business state (credits granted once, one ledger row, one BullMQ job).",
  "license": "MIT",
  "author": "Krrish Kumar (https://github.com/Krrishkumar125)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krrishkumar125/webhook-crash-lab.git"
  },
  "homepage": "https://github.com/Krrishkumar125/webhook-crash-lab#readme",
  "bugs": "https://github.com/Krrishkumar125/webhook-crash-lab/issues",
  "keywords": [
    "webhook",
    "stripe",
    "idempotency",
    "testing",
    "vitest",
    "jest",
    "bullmq",
    "redis",
    "duplicate",
    "race-condition",
    "ci",
    "payments"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./bullmq": {
      "import": {
        "types": "./dist/bullmq.d.ts",
        "default": "./dist/bullmq.js"
      },
      "require": {
        "types": "./dist/bullmq.d.cts",
        "default": "./dist/bullmq.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "webhook-crash-lab": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:exports": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "bullmq": ">=5",
    "jiti": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "jiti": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "bullmq": "^6.4.0",
    "eslint": "^10.13.0",
    "express": "^5.3.0",
    "globals": "^17.13.0",
    "ioredis": "^6.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "stripe": "^23.0.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12",
    "jiti": "^2.7.0"
  }
}
